# Copy to .env and adjust. Defaults match docker-compose.yml.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Runtime role. Can read/write platform tables, cannot read risk base tables.
DATABASE_URL=postgres://eidx_app:eidx_app_pw@localhost:5433/eidx
# Owner role. Used by migrate/seed/ingest scripts only.
DATABASE_ADMIN_URL=postgres://eidx_owner:eidx_owner_pw@localhost:5433/eidx

# Secret for hashing session tokens.
SESSION_SECRET=dev-session-secret-change-me
# Secret for signing short lived campus pass tokens.
PASS_SECRET=dev-pass-secret-change-me
# Shared credential for card readers posting taps and verification results.
READER_API_KEY=dev-reader-key-change-me

# Set to false for plain HTTP local development.
COOKIE_SECURE=false
# Preview login endpoint. Keep true only for demos, turn off once SSO lands.
PREVIEW_AUTH=true
