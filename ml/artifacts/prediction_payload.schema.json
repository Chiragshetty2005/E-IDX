{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidx.local/schemas/academic-risk-prediction-v1.json",
  "title": "EIDXAcademicRiskPrediction",
  "description": "Staff-only academic risk prediction for one student-module enrolment. Never expose this payload on student card or student-facing surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "cutoff_day",
    "generated_at",
    "risk_probability",
    "risk_tier",
    "drivers"
  ],
  "properties": {
    "model_version": {
      "type": "string"
    },
    "cutoff_day": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "student_ref": {
      "type": "string"
    },
    "module_ref": {
      "type": "string"
    },
    "risk_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "support",
        "watch",
        "on-track"
      ]
    },
    "drivers": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature",
          "label",
          "group",
          "value",
          "display",
          "shap_value",
          "direction"
        ],
        "properties": {
          "feature": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "display": {
            "type": [
              "string",
              "null"
            ]
          },
          "shap_value": {
            "type": "number"
          },
          "direction": {
            "type": "string",
            "enum": [
              "increases-risk",
              "reduces-risk"
            ]
          }
        }
      }
    }
  }
}